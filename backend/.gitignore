# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Môi trường ảo
venv/
.venv/
.setup-temp/
env/
ENV/

# File cấu hình môi trường chứa secret/keys
.env

# Tài liệu nguồn, chỉ mục và dữ liệu truy vấn cục bộ của RAG
data/raw/*
