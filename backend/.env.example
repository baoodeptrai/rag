PROJECT_NAME="Hệ thống Trợ lý ảo AI Sinh viên RAG"
API_V1_STR="/api"
VERSION="1.0.0"
HOST="127.0.0.1"
PORT=8000
DEBUG=True
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=".pdf,.docx"

# Thư mục upload mặc định là backend/data/raw.
# Có thể đặt đường dẫn tuyệt đối khác nếu nhóm muốn dùng kho tài liệu riêng.
# RAG_RAW_DIR=

EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
TOP_K=5
MIN_VECTOR_SIMILARITY=0.30
MIN_BM25_SCORE=1.0

# Ollama local, tương thích OpenAI. Chạy Ollama và tải model trước khi bật backend.
# LLM trả lời chỉ dựa trên chunks đã truy xuất; để trống API key khi chạy local.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
# Model tổng hợp câu trả lời; có thể chọn model Ollama 4B/7B phù hợp cấu hình máy.
LLM_MODEL=qwen2.5:7b
# Model offline phân loại ý định và chuẩn hóa câu hỏi trước khi retrieval.
ORCHESTRATOR_MODEL=qwen3:4b
# 0 = wait for Ollama without a socket timeout
LLM_TIMEOUT=0
ADMIN_API_TOKEN=replace-with-a-long-random-secret
