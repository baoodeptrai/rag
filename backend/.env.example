PROJECT_NAME="Hệ thống Trợ lý ảo AI Sinh viên RAG"
API_V1_STR="/api"
VERSION="1.0.0"
HOST="127.0.0.1"
PORT=8000
DEBUG=True
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=".pdf,.docx"

# Thư mục upload mặc định là backend/data/raw.
# Có thể đặt đường dẫn tuyệt đối khác nếu nhóm muốn dùng kho tài liệu riêng.
# RAG_RAW_DIR=

EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
TOP_K=5
MIN_VECTOR_SIMILARITY=0.30
MIN_BM25_SCORE=1.0

# Tùy chọn: endpoint API tương thích OpenAI để tạo câu trả lời từ các chunk truy xuất.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
